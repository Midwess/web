{
  "name": "website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "deno run --allow-all npm:vite --port 8080",
    "build": "npm run build:orbit && node scripts/ensure-worldant-vendor.mjs && vite-react-ssg build && npm run copy:ui-assets && node scripts/post-build.mjs",
    "build:dev": "npm run build:orbit && node scripts/ensure-worldant-vendor.mjs && vite-react-ssg build --mode development && npm run copy:ui-assets && node scripts/post-build.mjs",
    "build:orbit": "npm --prefix ui run build:lib",
    "copy:ui-assets": "node scripts/copy-orbit-assets.mjs",
    "preview": "vite preview",
    "test": "npm run build:orbit && vitest run"
  },
  "dependencies": {
    "@fumadocs/base-ui": "16.10.4",
    "@mdx-js/react": "^3.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@midwess/orbit-ui": "link:ui",
    "@paper-design/shaders-react": "^0.0.76",
    "@shikijs/rehype": "^1.26.0",
    "@tailwindcss/vite": "^4.2.2",
    "elkjs": "^0.11.1",
    "fumadocs-core": "16.10.4",
    "lucide-react": "^0.462.0",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "1.3.0",
    "react-router-dom": "^6.30.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^1.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@fumadocs/tailwind": "^0.0.5",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "github-slugger": "^2.0.0",
    "globals": "^15.15.0",
    "hast-util-to-string": "^3.0.1",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.6",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^5.4.19",
    "vite-react-ssg": "0.9.1-beta.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.28.2"
}
